# .env.production.example — production environment template for the FRONTEND (Vercel).
#
# HOW TO USE:
#   In the Vercel dashboard → Project Settings → Environment Variables, add:
#
#     NEXT_PUBLIC_API_URL = https://<your-backend-domain>   (Production env)
#
#   Example: NEXT_PUBLIC_API_URL=https://api-demo.example.com
#
# WARNING: NEXT_PUBLIC_* variables are inlined into the frontend bundle at
# BUILD time. Set the variable BEFORE deploying, and trigger a rebuild
# (redeploy) whenever it changes — changing it alone does not update a live
# deployment.
#
# No secrets belong in frontend env files or code. The frontend never sees
# ADMIN_API_KEY, LLM keys, or database paths.

NEXT_PUBLIC_API_URL=https://api-demo.example.com
