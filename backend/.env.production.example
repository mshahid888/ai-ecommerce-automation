# .env.production.example — production/demo environment template for the BACKEND.
#
# HOW TO USE (on the Hetzner server):
#   1. cp .env.production.example .env.production
#   2. Fill in the REQUIRED values below (generate ADMIN_API_KEY!).
#   3. chmod 600 .env.production
#   4. Point the systemd unit's EnvironmentFile at it (see deploy/ecommerce-demo.service).
#
# NEVER commit the filled-in .env.production — it is git-ignored (.env*).
# NEVER put these values in frontend code or in chat logs.

# ---------------------------------------------------------------- AI provider
# mock (default, deterministic, zero cost) | openai_compatible | gemini
LLM_PROVIDER=mock
# Model used only when LLM_PROVIDER is openai_compatible or gemini.
LLM_MODEL=gemini-3.8-flash
# API key for openai_compatible (or Gemini). REQUIRED when LLM_PROVIDER != mock.
# Prefer the connected-credential route for Gemini (see docs/ARCHITECTURE.md);
# only set LLM_API_KEY for openai_compatible or other OpenAI-style endpoints.
LLM_API_KEY=
# Base URL for openai_compatible endpoints. Ignore for mock/gemini.
LLM_BASE_URL=https://api.openai.com/v1
# Timeout per AI call, seconds. Keep below gunicorn timeout / nginx read timeout.
LLM_TIMEOUT_SECONDS=15
# Hard ceiling: max tokens the app will request per AI call (cost guardrail).
LLM_MAX_TOKENS_PER_REQUEST=300
# Daily cap of REAL AI requests for the public demo. Mock calls never count.
# When exceeded, the demo falls back to the deterministic mock with an honest note.
LLM_DAILY_REQUEST_CAP=500

# ------------------------------------------------------------- business rules
# Intent-confidence below this value routes the conversation to a human.
CONFIDENCE_THRESHOLD=0.6

# ----------------------------------------------------------- input hardening
MAX_MESSAGE_LENGTH=2000
MAX_BODY_BYTES=65536

# ------------------------------------------------------------ admin access
# REQUIRED in production. Used as X-Admin-Key for mutating admin endpoints
# (e.g. POST /api/demo/reset). Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the app generates one on first boot and stores it in
# backend/data/.admin_key (0600) — do NOT rely on that in production.
ADMIN_API_KEY=

# ---------------------------------------------------------- rate limiting
# Master switch. Keep ON for the public demo.
RATE_LIMIT_ENABLED=true
# POST /api/chat: per-IP limits
RL_CHAT_PER_MINUTE=30
RL_CHAT_PER_DAY=200
# GET /api/*: per-IP limit
RL_READ_PER_MINUTE=60
# POST /api/demo/reset: per-IP limit (reset is admin-authenticated anyway)
RL_RESET_PER_HOUR=5
# Fraction of rate-limit rejections sampled into the audit log (0.05 = 5%).
AUDIT_SAMPLE_RATE=0.05

# --------------------------------------------------------------- database
# SQLite path for the demo. Relative paths resolve under backend/.
DATABASE_URL=sqlite:///./data/demo.db

# ------------------------------------------------------------------ demo
# Keep true for the public demo: demo banner, fictional seed data, reset allowed.
DEMO_MODE=true

# ------------------------------------------------------------------- CORS
# Comma-separated. In production: ONLY the real Vercel frontend domain(s).
# No wildcard, no localhost entries. Example:
# CORS_ORIGINS=https://ai-ecommerce-automation.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
